# ─── Data — raw files are large and proprietary ──────────────────────────────
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.parquet
# Keep processed outputs that are derived and small
!data/processed/*.csv

# ─── Model checkpoints (large binary files — use Git LFS if needed) ──────────
models/*.ckpt
models/*.pth
# Keep the final deployment kernel weight file
!models/kernel_final_modelC.pt

# ─── Lightning logs (training artefacts) ─────────────────────────────────────
lightning_logs/
*.ckpt
.lr_find_*.ckpt

